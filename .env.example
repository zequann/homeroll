# Homeroll environment. Copy to .env.local (local) or set in Vercel env (hosted).
# Everything here is server-only: none of it may be exposed with a NEXT_PUBLIC_ prefix.
# Testnet only. Never put a mainnet key in any of these.

# --- Network -------------------------------------------------------------------

# Only testnet is supported (SPEC §2: no mainnet deployment).
NEAR_NETWORK=testnet

# Root account. Every Homeroll account is built from it (tusdc.<root>, payroll.<root>,
# w-xxxxxx.<root>, ...) by the helper in packages/shared; never hard-code it.
NEAR_ROOT_ACCOUNT=homeroll.testnet

# Testnet RPC for all reads and writes.
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Mainnet RPC for read-only view calls only: Rhea Lend rate (SPEC §8.10), gas price and
# protocol limits for the measurements (SPEC §15). Nothing is ever signed against it.
NEAR_MAINNET_RPC_URL=https://free.rpc.fastnear.com

# Which ChainClient the app uses (SPEC §8.8): "fake" = fixtures, no chain needed;
# "near" = the contracts on NEAR_NETWORK.
CHAIN_CLIENT=fake

# Optional. Send home's swap leg: "live" = NEAR Intents dry-run quote (no funds move, no key);
# "sample" = a labelled made-up number. Empty = live with CHAIN_CLIENT=near, sample with fake.
INTENTS_QUOTES=

# Optional. 1Click partner key (a JWT from https://partners.near-intents.org), sent as
# X-API-Key on every 1Click request (SPEC §8.4). Removes the 0.25% fee for unauthenticated
# callers, and lets lender deposits ask for a confidential dry-run quote (SPEC §8.9, Q9).
# Quotes are dry runs only: this key never moves funds. Empty = no key, quotes still work.
ONECLICK_API_KEY=

# Optional. Token contract the app pays in. Empty = tusdc.<root>. Lets small-amount flows
# switch to Circle's testnet USDC (SPEC §7.1).
TOKEN_CONTRACT_ID=

# --- Keys (server only) ----------------------------------------------------------

# Full-access key of NEAR_ROOT_ACCOUNT, format "ed25519:...". Either the 32-byte seed or
# the 64-byte key a NEAR wallet exports. The root is the Homeroll admin: deploy, seed
# and Reset demo sign with it.
HOMEROLL_ADMIN_PRIVATE_KEY=

# Secret seed for every other key the server holds (SPEC §12): the 40 worker demo keys,
# each demo company's owner key and payroll agent key, and the service accounts
# (agent, relayer, escrow, solver). Each key is derived from this seed and the account
# ID, so scripts and server compute the same keys and none are stored. Changing it
# replaces all of them, which then need a fresh deploy and seed.
# Generate: openssl rand -hex 32
SERVER_KEY_SEED=

# --- Supabase (off-chain data, SPEC §8.7) ----------------------------------------
# Optional locally: with both empty the app keeps these records in memory, as before. Needed on
# Vercel, where requests run on several server instances. Create the tables once by running
# supabase/schema.sql in Supabase → SQL Editor.

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...). Server only: bypasses row-level security.
SUPABASE_SECRET_KEY=
